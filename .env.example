# Copiez ce fichier vers .env et adaptez les valeurs.
# Ne jamais commit le fichier .env (deja ignore par .gitignore).

# --- Backend ---

# Port d'ecoute de l'API
PORT=3001

# URL de connexion PostgreSQL (format standard libpq)
# Docker Compose : voir docker-compose.yml (service "db")
# Installation locale/service : adapter host/port/user/password
DATABASE_URL=postgresql://openbackup:openbackup@localhost:5432/openbackup

# Secret utilise pour signer les JWT de session. Generez une valeur aleatoire forte, par ex. :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez-moi-avec-une-valeur-aleatoire-longue

# Origine autorisee pour les requetes CORS (URL du frontend)
CORS_ORIGIN=http://localhost:5173

# Environnement d'execution (development | production | test)
NODE_ENV=development

# --- Frontend ---

# URL de base de l'API backend, utilisee par le frontend
VITE_API_URL=http://localhost:3001
